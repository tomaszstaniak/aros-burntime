From 81b754d91a104894c0a8493fe001229aff6008ae Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Sat, 12 Sep 2026 01:30:51 +0200
Subject: [PATCH 07/11] Carry a file to the guest on the disc

The AROS Shell takes about 255 characters of a typed command and then
stops accepting input, Return included, so a long argument list cannot
be submitted at all. --carry <path> puts the named file on the ISO
beside the binary and rewrites the argument to AMIDEV:<name>, which is
how a script longer than a command line reaches the guest.
---
 aros/src/fs.rs         | 24 +++++++++++++++++-------
 tools/aros-qemu-run.py | 31 +++++++++++++++++++++++++++++--
 2 files changed, 46 insertions(+), 9 deletions(-)

diff --git a/aros/src/fs.rs b/aros/src/fs.rs
index 08b69fa..0e5fdca 100644
--- a/aros/src/fs.rs
+++ b/aros/src/fs.rs
@@ -269,13 +269,23 @@ fn exists_dir(path: &str) -> bool {
 /// requires that — close it, move the old file aside, move the new one in,
 /// and only then drop the old one.
 ///
-/// What that does and does not buy, said plainly: **a failure at any step
-/// leaves a complete copy of the previous save on disk**, as either the real
-/// file or the `.bak` beside it. What it cannot promise is that the real
-/// name always exists — between moving the old aside and the new one in
-/// there is a window where it does not, and a machine that dies inside it
-/// leaves the previous save under `.bak`. Recovering that is the caller's
-/// business, and it is a smaller problem than a half-written save.
+/// **What this does and does not buy, narrowly.** Against the failures it
+/// can see — a full disk, a refused open, a write or close that reports an
+/// error — the previous save survives, as either the real file or the
+/// `.bak` beside it, and the error says so. It also survives the process
+/// going away between steps, because each step is a whole operation.
+///
+/// It is **not** crash safety. Nothing here orders writes against the
+/// filesystem's own caching or asks it to commit, so a power cut or a
+/// kernel that dies mid-operation can leave any of these files short or
+/// absent. Getting further than this would need guarantees from the
+/// filesystem that we have not established for SFS, and claiming them
+/// without would be worse than not having them.
+///
+/// The one thing a caller must do: **when the real name is missing and a
+/// `.bak` is beside it, say so.** That is a save interrupted between the
+/// two moves, and the previous game is sitting right there under a name
+/// nobody will look for on their own.
 pub fn replace(path: &str, data: &[u8]) -> Result<(), Error> {
     let mut tmp = PathBuf::new(path)?;
     tmp.push(".new")?;
diff --git a/tools/aros-qemu-run.py b/tools/aros-qemu-run.py
index 849f413..dd2478f 100755
--- a/tools/aros-qemu-run.py
+++ b/tools/aros-qemu-run.py
@@ -123,17 +123,24 @@ class Qmp:
                 die(f"cannot type {c!r} - rename the binary to plain ASCII")
 
 
-def build_iso(binary, workdir):
+def build_iso(binary, workdir, extra=()):
     """Wrap the binary in an ISO the guest can mount.
 
     Two ISO paths are used in turn: QEMU keeps the inserted medium open, so
     the new image must never be the file currently in the drive.
+
+    `extra` names further files to carry alongside it. The reason this
+    exists: the guest's Shell truncates a typed command at about 255
+    characters, so anything longer than that has to arrive as a file rather
+    than as arguments.
     """
     stage = os.path.join(workdir, "stage")
     if os.path.isdir(stage):
         shutil.rmtree(stage)
     os.makedirs(stage)
     shutil.copy2(binary, stage)
+    for path in extra:
+        shutil.copy2(path, stage)
 
     marker = os.path.join(workdir, "current")
     previous = ""
@@ -231,6 +238,26 @@ def main():
     # arguments can be told what to do without being rebuilt.
     program_args = sys.argv[2:]
 
+    # `--carry <path>` puts a further file on the disc beside the binary and
+    # rewrites the argument to name it as the guest will see it. The guest's
+    # Shell truncates a typed command at about 255 characters, so a long
+    # script has to travel as a file; this is how it gets there.
+    carry = []
+    cleaned = []
+    i = 0
+    while i < len(program_args):
+        if program_args[i] == "--carry" and i + 1 < len(program_args):
+            path = program_args[i + 1]
+            if not os.path.exists(path):
+                die(f"--carry: no such file: {path}")
+            carry.append(path)
+            cleaned.append("AMIDEV:" + os.path.basename(path))
+            i += 2
+            continue
+        cleaned.append(program_args[i])
+        i += 1
+    program_args = cleaned
+
     for path, what in ((MONITOR, "monitor"), (QMP, "QMP")):
         if not os.path.exists(path):
             die(f"no QEMU {what} socket at {path} - is the AROS machine running?")
@@ -238,7 +265,7 @@ def main():
     # Keep the ISO on disk: QEMU holds the file open while the medium is in.
     workdir = os.path.join(tempfile.gettempdir(), "aros-run")
     os.makedirs(workdir, exist_ok=True)
-    iso = build_iso(binary, workdir)
+    iso = build_iso(binary, workdir, carry)
 
     # AROS keeps serving the old disc unless it sees a real eject first.
     monitor_cmd(f"eject -f {CD}")
