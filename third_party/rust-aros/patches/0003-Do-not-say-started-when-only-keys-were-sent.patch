 macro_rules! aros_main {
     ($f:ident) => {
         #[no_mangle]
-        pub extern "C" fn main(_argc: i32, _argv: *const *const u8) -> i32 {
+        pub extern "C" fn main(argc: i32, argv: *const *const u8) -> i32 {
+            // The Shell's own command line, kept for `aros::args()`. AROS
