+
+fn require(var: &str, what: &str) -> String {
+    env::var(var).unwrap_or_else(|_| {
+        panic!(
+            "{var} is not set. It must name {what}. \
+             Run ./setup.sh to write aros-env.toml, or set it yourself — and make sure \
