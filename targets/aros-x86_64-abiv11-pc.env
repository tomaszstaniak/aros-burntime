# AROS One 1.3 and other ABIv11 systems: GCC 10.5.0 and the older ABIv11 SDK
# (the pair every ABIv11 candidate so far was built with; docs/platform-review.md).
# collect-aros needs /Volumes/arosbuild mounted.
AROS_GCC=${AROS_GCC:-$HOME/Work/AROS/toolchain/x86_64-aros-gcc}
AROS_AR=${AROS_AR:-$HOME/Work/AROS/toolchain/x86_64-aros-ar}
AROS_SDK=${AROS_SDK:-$HOME/Work/AROS/sdk}
