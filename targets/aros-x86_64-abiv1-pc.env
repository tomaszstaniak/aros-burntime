# Mainline AROS x86_64: the toolchain and SDK of the mainline build of
# 2026-10-26 (AROS 87266168, contrib 45327d2c), from a disk image
# mounted at /Volumes/arosv1. Its GCC 10.5.0 is the same binary as the older mainline
# toolchain's; its collect-aros points at this build's SDK.
AROS_GCC=${AROS_GCC:-/Volumes/arosv1/toolchain-mainline/x86_64-aros-gcc}
AROS_AR=${AROS_AR:-/Volumes/arosv1/toolchain-mainline/x86_64-aros-ar}
AROS_SDK=${AROS_SDK:-/Volumes/arosv1/build/bin/pc-x86_64/AROS/Developer}
