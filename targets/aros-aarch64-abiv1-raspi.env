# Native AROS on the Raspberry Pi (aarch64, ABIv1): Clang 20.1.0 and the SDK of the
# official AROS-20260822-raspi-aarch64-system archive (see its README).
# Not Macaros: that is hosted on macOS and has its own SDK.
AROS_GCC=${AROS_GCC:-$HOME/Work/AROS/toolchains/raspi-aarch64/bin/aarch64-aros-gcc}
AROS_AR=${AROS_AR:-$HOME/Work/AROS/toolchains/raspi-aarch64/bin/aarch64-aros-ar}
AROS_SDK=${AROS_SDK:-$HOME/Work/AROS/toolchains/raspi-aarch64/sdk}
