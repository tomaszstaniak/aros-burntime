' The control of v12_viewport_info: the same steps with every resize and
' switch a `resize 640x480`, which at that size changes nothing.
press escape             ' Back closes the manual v1.2 opens on a new game's first world map
mapclick 110,122         ' into Paradise Camp
wait 60
join                     ' camped here: the place is ours
wait 10
press r                  ' INFO
wait 3
snap info_640
resize 640x480
wait 3
snap info_1920
sceneclick 240,115       ' the production: the first, by choice
wait 3
snap info_1920_chosen
resize 640x480
wait 3
snap info_600
sceneclick 240,115       ' the next production
wait 3
resize 640x480
wait 3
snap info_full
sceneclick 240,115       ' and the next, in fullscreen
wait 3
resize 640x480
wait 3
snap info_back
sceneclick 10,180        ' Back: INFO closed
wait 3
snap map_after_info
press h                  ' the statistics
wait 3
snap stats_back
resize 640x480
wait 3
snap stats_1280
resize 640x480
wait 3
snap stats_full
resize 640x480
wait 3
resize 640x480
wait 3
snap stats_600
sceneclick 160,100       ' any click closes them
wait 3
snap map_after_stats
resize 640x480
wait 3
save
quit
